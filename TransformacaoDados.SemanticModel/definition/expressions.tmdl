expression nomes_colaboradores =
		let
		    Fonte = employee_raw,
		    Selecionadas = Table.SelectColumns(Fonte, {"Ssn", "Fname", "Lname"}),
		    NomeMesclado = Table.CombineColumns(Selecionadas, {"Fname", "Lname"}, Combiner.CombineTextByDelimiter(" ", QuoteStyle.None), "Nome")
		in
		    NomeMesclado
	lineageTag: 272d0c94-cdf2-4672-bb90-7936a1d16717

	annotation PBI_ResultType = Table
