	partition Dependentes = m
		mode: import
		source =
				let
				    Fonte = dependent_raw,
				    TiposAlterados = Table.TransformColumnTypes(Fonte, {{"Essn", type text}, {"Dependent_name", type text}, {"Sex", type text}, {"Bdate", type date}, {"Relationship", type text}}, "en-US"),
				    Filha = Table.ReplaceValue(TiposAlterados, "Daughter", "Filha", Replacer.ReplaceValue, {"Relationship"}),
				    Filho = Table.ReplaceValue(Filha, "Son", "Filho", Replacer.ReplaceValue, {"Relationship"}),
				    Conjuge = Table.ReplaceValue(Filho, "Spouse", "Cônjuge", Replacer.ReplaceValue, {"Relationship"}),
