		sourceColumn: Qtd Colaboradores

		annotation SummarizationSetBy = Automatic

	partition Projetos = m
		mode: import
		source =
				let
				    Fonte = project_raw,
				    TiposAlterados = Table.TransformColumnTypes(Fonte, {{"Pname", type text}, {"Pnumber", Int64.Type}, {"Plocation", type text}, {"Dnum", Int64.Type}}, "en-US"),
				    // Verificação das horas: total de horas e quantidade de colaboradores em cada projeto
				    HorasPorProjeto = Table.Group(Trabalha_Em, {"Nº Projeto"}, {{"Total de Horas", each List.Sum([Horas]), type number}, {"Qtd Colaboradores", each Table.RowCount(_), Int64.Type}}),
				    MesclaHoras = Table.NestedJoin(TiposAlterados, {"Pnumber"}, HorasPorProjeto, {"Nº Projeto"}, "TabelaHoras", JoinKind.LeftOuter),
				    HorasExpandidas = Table.ExpandTableColumn(MesclaHoras, "TabelaHoras", {"Total de Horas", "Qtd Colaboradores"}, {"Total de Horas", "Qtd Colaboradores"}),
				    MesclaDepartamento = Table.NestedJoin(HorasExpandidas, {"Dnum"}, Departamentos, {"Nº Departamento"}, "TabelaDepartamento", JoinKind.LeftOuter),
				    DepartamentoExpandido = Table.ExpandTableColumn(MesclaDepartamento, "TabelaDepartamento", {"Departamento"}, {"Departamento"}),
				    Renomeadas = Table.RenameColumns(DepartamentoExpandido, {{"Pname", "Projeto"}, {"Pnumber", "Nº Projeto"}, {"Plocation", "Local do Projeto"}, {"Dnum", "Nº Departamento"}}),
				    TiposFinais = Table.TransformColumnTypes(Renomeadas, {{"Total de Horas", type number}, {"Qtd Colaboradores", Int64.Type}, {"Departamento", type text}}),
				    ColunasFinais = Table.SelectColumns(TiposFinais, {"Nº Projeto", "Projeto", "Local do Projeto", "Nº Departamento", "Departamento", "Total de Horas", "Qtd Colaboradores"})
				in
				    ColunasFinais

	annotation PBI_ResultType = Table
