	partition Departamento_Local = m
		mode: import
		source =
				let
				    Fonte = dept_locations_raw,
				    TiposAlterados = Table.TransformColumnTypes(Fonte, {{"Dnumber", Int64.Type}, {"Dlocation", type text}}, "en-US"),
				    MesclaDepartamento = Table.NestedJoin(TiposAlterados, {"Dnumber"}, Departamentos, {"Nº Departamento"}, "TabelaDepartamento", JoinKind.LeftOuter),
				    DepartamentoExpandido = Table.ExpandTableColumn(MesclaDepartamento, "TabelaDepartamento", {"Departamento"}, {"Departamento"}),
				    // Nome do departamento + local: cada combinação departamento-local fica única (base para o modelo estrela)
				    DepartamentoLocal = Table.AddColumn(DepartamentoExpandido, "Departamento-Local", each Text.Combine({[Departamento], [Dlocation]}, " - "), type text),
				    Ordenado = Table.Sort(DepartamentoLocal, {{"Dnumber", Order.Ascending}, {"Dlocation", Order.Ascending}}),
				    Indice = Table.AddIndexColumn(Ordenado, "ID Departamento-Local", 1, 1, Int64.Type),
				    Renomeadas = Table.RenameColumns(Indice, {{"Dnumber", "Nº Departamento"}, {"Dlocation", "Local"}}),
				    TiposFinais = Table.TransformColumnTypes(Renomeadas, {{"Departamento", type text}}),
				    ColunasFinais = Table.SelectColumns(TiposFinais, {"ID Departamento-Local", "Nº Departamento", "Departamento", "Local", "Departamento-Local"})
				in
				    ColunasFinais

	annotation PBI_ResultType = Table
