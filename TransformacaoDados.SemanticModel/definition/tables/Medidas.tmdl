	measure 'Total de Projetos' = COUNTROWS(Projetos)
		formatString: #,0
		lineageTag: 24677d1d-ffb6-4c73-b6fa-8eb5f243ea35

	measure 'Horas Trabalhadas' = SUM(Trabalha_Em[Horas])
		formatString: #,0.0
		lineageTag: 2d890410-ce55-49dc-8832-3f296b71a9ed

	measure 'Folha Salarial' = SUM(Colaboradores[Salário])
		formatString: \$#,0;(\$#,0);\$#,0
