	measure 'Total de Dependentes' = COUNTROWS(Dependentes)
		formatString: #,0
		lineageTag: f9d428c6-7a2c-43b5-ac61-778963d25d36

	column Coluna
		dataType: string
		isHidden
		lineageTag: 59fd04b8-b701-4abc-bbc5-9ecc9ba6b913
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
