	column Gerente
		dataType: string
		lineageTag: 7703a487-51f1-4584-8604-918d69c11531
		summarizeBy: none
		sourceColumn: Gerente

		annotation SummarizationSetBy = Automatic

	partition Colaboradores = m
		mode: import
		source =
				let
				    Fonte = employee_raw,
				    VaziosParaNulo = Table.ReplaceValue(Fonte, "", null, Replacer.ReplaceValue, {"Minit", "Bdate", "Address", "Sex", "Salary", "Super_ssn"}),
				    // Salário como número decimal fixo (Currency.Type), o tipo preciso para valores monetários
				    TiposAlterados = Table.TransformColumnTypes(VaziosParaNulo, {{"Fname", type text}, {"Minit", type text}, {"Lname", type text}, {"Ssn", type text}, {"Bdate", type date}, {"Address", type text}, {"Sex", type text}, {"Salary", Currency.Type}, {"Super_ssn", type text}, {"Dno", Int64.Type}}, "en-US"),
				    // Coluna complexa: o endereço vem como Número-Rua-Cidade-Estado e a rua pode ter hífen (ex.: 975-Fire-Oak-Humble-TX)
				    PartesEndereco = Table.AddColumn(TiposAlterados, "PartesEndereco", each Text.Split([Address], "-")),
				    Numero = Table.AddColumn(PartesEndereco, "Número", each List.First([PartesEndereco]), type text),
				    Rua = Table.AddColumn(Numero, "Rua", each Text.Combine(List.Range([PartesEndereco], 1, List.Count([PartesEndereco]) - 3), " "), type text),
				    Cidade = Table.AddColumn(Rua, "Cidade", each [PartesEndereco]{List.Count([PartesEndereco]) - 2}, type text),
				    Estado = Table.AddColumn(Cidade, "Estado", each List.Last([PartesEndereco]), type text),
				    // Nome + Sobrenome em uma única coluna
				    NomeCompleto = Table.CombineColumns(Estado, {"Fname", "Lname"}, Combiner.CombineTextByDelimiter(" ", QuoteStyle.None), "Nome Completo"),
				    // Autojunção: nome do gerente de cada colaborador (Super_ssn = Ssn)
				    MesclaGerente = Table.NestedJoin(NomeCompleto, {"Super_ssn"}, nomes_colaboradores, {"Ssn"}, "TabelaGerente", JoinKind.LeftOuter),
				    GerenteExpandido = Table.ExpandTableColumn(MesclaGerente, "TabelaGerente", {"Nome"}, {"Gerente"}),
				    // Super_ssn nulo = colaborador sem gerente (topo da hierarquia). A linha é mantida e identificada
				    SemGerente = Table.ReplaceValue(GerenteExpandido, null, "Sem gerente (diretor)", Replacer.ReplaceValue, {"Gerente"}),
				    // Mescla com departamentos usando junção externa esquerda: a base é employee e todos os colaboradores são mantidos
				    MesclaDepartamento = Table.NestedJoin(SemGerente, {"Dno"}, Departamentos, {"Nº Departamento"}, "TabelaDepartamento", JoinKind.LeftOuter),
				    DepartamentoExpandido = Table.ExpandTableColumn(MesclaDepartamento, "TabelaDepartamento", {"Departamento"}, {"Departamento"}),
				    Renomeadas = Table.RenameColumns(DepartamentoExpandido, {{"Ssn", "SSN"}, {"Bdate", "Data Nascimento"}, {"Sex", "Sexo"}, {"Salary", "Salário"}, {"Super_ssn", "SSN Gerente"}, {"Dno", "Nº Departamento"}}),
				    TiposFinais = Table.TransformColumnTypes(Renomeadas, {{"Nome Completo", type text}, {"Gerente", type text}, {"Departamento", type text}}),
				    // Remove colunas desnecessárias (Minit, Address e a lista auxiliar PartesEndereco)
				    ColunasFinais = Table.SelectColumns(TiposFinais, {"SSN", "Nome Completo", "Sexo", "Data Nascimento", "Salário", "Número", "Rua", "Cidade", "Estado", "Nº Departamento", "Departamento", "SSN Gerente", "Gerente"})
				in
				    ColunasFinais

	annotation PBI_ResultType = Table
