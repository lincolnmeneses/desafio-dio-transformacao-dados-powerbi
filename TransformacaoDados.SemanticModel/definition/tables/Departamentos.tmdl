	column 'Possui Gerente'
		dataType: string
		lineageTag: 9e0d4e58-8b62-4dad-806b-486df65bf563
		summarizeBy: none
		sourceColumn: Possui Gerente

		annotation SummarizationSetBy = Automatic

	partition Departamentos = m
		mode: import
		source =
				let
				    Fonte = departament_raw,
				    VaziosParaNulo = Table.ReplaceValue(Fonte, "", null, Replacer.ReplaceValue, {"Mgr_ssn", "Mgr_start_date", "Dept_create_date"}),
				    TiposAlterados = Table.TransformColumnTypes(VaziosParaNulo, {{"Dname", type text}, {"Dnumber", Int64.Type}, {"Mgr_ssn", type text}, {"Mgr_start_date", type date}, {"Dept_create_date", type date}}, "en-US"),
				    // Nome do gerente de cada departamento (Mgr_ssn = Ssn)
				    MesclaGerente = Table.NestedJoin(TiposAlterados, {"Mgr_ssn"}, nomes_colaboradores, {"Ssn"}, "TabelaGerente", JoinKind.LeftOuter),
				    GerenteExpandido = Table.ExpandTableColumn(MesclaGerente, "TabelaGerente", {"Nome"}, {"Gerente do Departamento"}),
				    // Verificação de departamentos sem gerente; se existir algum, a lacuna é preenchida
				    PossuiGerente = Table.AddColumn(GerenteExpandido, "Possui Gerente", each if [Mgr_ssn] = null then "Não" else "Sim", type text),
				    LacunasPreenchidas = Table.ReplaceValue(PossuiGerente, null, "Gerente a definir", Replacer.ReplaceValue, {"Gerente do Departamento"}),
				    Renomeadas = Table.RenameColumns(LacunasPreenchidas, {{"Dnumber", "Nº Departamento"}, {"Dname", "Departamento"}, {"Mgr_ssn", "SSN Gerente"}, {"Mgr_start_date", "Gerente Desde"}}),
				    TiposFinais = Table.TransformColumnTypes(Renomeadas, {{"Gerente do Departamento", type text}}),
				    // Dept_create_date não é usada no relatório e foi removida
				    ColunasFinais = Table.SelectColumns(TiposFinais, {"Nº Departamento", "Departamento", "SSN Gerente", "Gerente do Departamento", "Gerente Desde", "Possui Gerente"})
				in
				    ColunasFinais

	annotation PBI_ResultType = Table
